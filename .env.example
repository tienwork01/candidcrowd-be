APP_NAME=CandidCrowd
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgres://candidcrowd:replace-with-a-long-random-secret@localhost:5432/candidcrowd?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
REDIS_URL=redis://:replace-with-a-long-random-secret@localhost:6379/0
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=candidcrowd-api
CORS_ALLOWED_ORIGINS=http://localhost:3000
TERMS_VERSION=2026-01
PRIVACY_VERSION=2026-01
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=candidcrowd-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_EXPIRY=15m
UPLOAD_MAX_IMAGE_BYTES=26214400
UPLOAD_MAX_VIDEO_BYTES=524288000
EVENT_MAX_MEDIA_BYTES=5368709120
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW=1m
