# development | staging | production. Production requires R2 credentials.
APP_ENV=development
# Gin listen address; :8080 listens on all interfaces locally.
HTTP_ADDR=:8080
LOG_LEVEL=info
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret
# PostgreSQL DSN. Use sslmode=require (or stronger) in production.
DATABASE_URL=postgres://candidcrowd:replace-with-a-long-random-secret@localhost:5432/candidcrowd?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
REDIS_URL=redis://:replace-with-a-long-random-secret@localhost:6379/0
# Public JWKS endpoint used by the Go API to verify host JWTs.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=candidcrowd-api
# Comma-separated browser origins allowed to call this API; do not include
# trailing slashes. This does NOT configure the R2 bucket itself: configure the
# same origins in R2 > bucket > Settings > CORS Policy for direct uploads.
CORS_ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000,https://192.168.88.218:3000
TERMS_VERSION=2026-01
PRIVACY_VERSION=2026-01
# R2 S3-compatible account endpoint, not a public bucket URL.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# Private R2 bucket used for direct guest uploads.
R2_BUCKET=candidcrowd-media
# R2 API-token credentials. Keep both server-side only; inject secrets in deployment.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Lifetime of browser signed upload/download URLs, e.g. 15m.
R2_PRESIGN_EXPIRY=15m
# Per-file limits in bytes: 25 MiB image, 500 MiB video by default.
UPLOAD_MAX_IMAGE_BYTES=26214400
UPLOAD_MAX_VIDEO_BYTES=524288000
EVENT_MAX_MEDIA_BYTES=5368709120
# Event plans rollout. ENTITLEMENT_ENFORCEMENT_ENABLED=false keeps uploads capped by
# EVENT_MAX_MEDIA_BYTES instead of each event's plan; run `planctl backfill-legacy`
# with the switch-on time as cutoff before turning it on.
PLANS_CATALOG_ENABLED=true
PLANS_PRICING_UI_ENABLED=false
MANUAL_PLAN_ACTIVATION_ENABLED=false
ENTITLEMENT_ENFORCEMENT_ENABLED=false
# Retention permanently deletes an event's media once its plan's storage period
# plus RETENTION_GRACE has passed. While false the daily job only logs due events;
# preview with `planctl retention --dry-run` before turning it on.
RETENTION_ENFORCEMENT_ENABLED=false
RETENTION_GRACE=720h
RETENTION_SCHEDULE=30 3 * * *
RETENTION_BATCH=25
# Max upload-target requests per anonymous guest session during the window below.
UPLOAD_RATE_LIMIT=20
# Go duration format for the rate-limit window.
UPLOAD_RATE_WINDOW=1m
# Enables Google Drive archive scheduling only after all OAuth values below are configured.
MEDIA_DAILY_ARCHIVE_ENABLED=false
# Cron format: minute hour day-of-month month day-of-week; 02:00 every day.
MEDIA_DAILY_ARCHIVE_SCHEDULE=0 2 * * *
# Archive only media that has been ready at least this long.
MEDIA_DAILY_ARCHIVE_MIN_AGE=24h
# OAuth client for the owner's private Google Drive archive.
GOOGLE_DRIVE_CLIENT_ID=
# OAuth client secret; never commit or expose to the frontend.
GOOGLE_DRIVE_CLIENT_SECRET=
# Long-lived OAuth refresh token; inject through a secret manager and never log it.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Google Drive folder ID for archives, not a browser share URL.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Billing & Payments (Paddle). Disabled by default.
BILLING_ENABLED=false
BILLING_PROVIDER=paddle
BILLING_CURRENCY=USD
BILLING_SUCCESS_URL=http://localhost:3000/billing/return
BILLING_CANCEL_URL=http://localhost:3000/billing/return?status=canceled
BILLING_RECONCILE_SCHEDULE=*/5 * * * *
BILLING_RECONCILE_BATCH=50

# Paddle API credentials (required when BILLING_ENABLED=true).
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_sandbox_api_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
# Optional, and LEAVE IT EMPTY unless you know the domain is approved.
#
# Paddle always needs a default payment link on the account (Checkout ->
# Checkout settings); without one it refuses to create any transaction. Setting
# this variable sends checkout.url per transaction instead, which Paddle accepts
# ONLY for a domain approved under My account -> Website approval. An
# unapproved value — localhost included — fails every checkout with
# transaction_checkout_url_domain_is_not_approved. Empty means "use the
# account default", which is what a normal deployment wants.
PADDLE_CHECKOUT_URL=
